<Window x:Class="SldBuilder.Acad.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:SldBuilder.Acad.Resources"
        Title="{x:Static res:Strings.WindowTitle}"
        Width="800" Height="540"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="BrowseButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Content" Value="..." />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Header: welcome text + picture of a diagram -->
        <Grid DockPanel.Dock="Top" Height="230">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Border Background="White" Padding="16">
                <TextBlock Text="{x:Static res:Strings.WelcomeText}" TextWrapping="Wrap" FontSize="15" />
            </Border>
            <Image Grid.Column="1" Stretch="Uniform"
                   Source="/SldBuilder.Acad;component/Resources/sld_white.png" />
        </Grid>

        <Separator DockPanel.Dock="Top" />

        <!-- Buttons -->
        <Grid DockPanel.Dock="Bottom" Margin="16">
            <Button Content="{x:Static res:Strings.Build}" IsDefault="True" Click="OnBuild"
                    Width="200" Height="40" FontSize="15" HorizontalAlignment="Center" />
            <Button Content="{x:Static res:Strings.Cancel}" IsCancel="True"
                    Width="100" Height="26" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
        </Grid>

        <!-- File selection -->
        <StackPanel Margin="40,12,40,0">
            <TextBlock Text="{x:Static res:Strings.ExcelLabel}" Margin="0,0,0,4" />
            <DockPanel>
                <Image DockPanel.Dock="Left" Width="18" Height="20" Margin="0,0,6,0"
                       Source="/SldBuilder.Acad;component/Resources/xlsx.png" />
                <Button DockPanel.Dock="Right" Style="{StaticResource BrowseButton}" Click="OnBrowseExcel" />
                <TextBox x:Name="ExcelPath" VerticalContentAlignment="Center" Height="25" />
            </DockPanel>

            <DockPanel Margin="0,16,0,4">
                <CheckBox x:Name="NewFromTemplate" DockPanel.Dock="Right" VerticalAlignment="Center"
                          Content="{x:Static res:Strings.NewFromTemplate}"
                          Checked="OnNewFromTemplateChanged" Unchecked="OnNewFromTemplateChanged" />
                <TextBlock Text="{x:Static res:Strings.DwgLabel}" />
            </DockPanel>
            <DockPanel>
                <Image DockPanel.Dock="Left" Width="18" Height="20" Margin="0,0,6,0"
                       Source="/SldBuilder.Acad;component/Resources/dwg.png" />
                <Button DockPanel.Dock="Right" Style="{StaticResource BrowseButton}" Click="OnBrowseDwg" />
                <TextBox x:Name="DwgPath" VerticalContentAlignment="Center" Height="25" />
            </DockPanel>
        </StackPanel>
    </DockPanel>
</Window>
